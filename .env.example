COMPOSE_PROJECT_NAME=awesome-project

# PostgreSQL container
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=meeting_service
POSTGRES_PORT=5432

# MinIO container
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=meetings
MINIO_USE_SSL=false
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application ports exposed on the host
MEETING_SERVICE_PORT=8000
AI_SERVICE_PORT=8001

# Used when meeting-service is started locally, outside Docker Compose
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/meeting_service?sslmode=disable
HTTP_ADDR=:8000
MINIO_ENDPOINT=localhost:9000
